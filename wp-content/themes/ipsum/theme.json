{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"customTemplates": [
		{
			"name": "single-sidebar",
			"postTypes": [
				"post"
			],
			"title": "Single Posts Sidebar"
		},
		{
			"name": "page-sidebar",
			"postTypes": [
				"page"
			],
			"title": "Pages Sidebar"
		},
		{
			"name": "page-no-title",
			"postTypes": [
				"page"
			],
			"title": "Pages No Title"
		}
	],
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"duotone": [
				{
					"colors": [
						"#000000",
						"#FFFFFF"
					],
					"name": "Black and white",
					"slug": "duotone-1"
				}
			],
			"gradients": [
				{
					"gradient": "linear-gradient(to bottom, var(--wp--preset--color--theme-5) 0%, var(--wp--preset--color--theme-1) 100%)",
					"name": "Vertical soft wash to base",
					"slug": "gradient-1"
				},
				{
					"gradient": "linear-gradient(to bottom, var(--wp--preset--color--theme-5) 90%, var(--wp--preset--color--theme-1) 90%)",
					"name": "Vertical hard wash to base",
					"slug": "gradient-2"
				}
			],
			"palette": [
				{
					"color": "#fcfcfc",
					"name": "Color 1",
					"slug": "theme-1"
				},
				{
					"color": "#000000bf",
					"name": "Color 2",
					"slug": "theme-2"
				},
				{
					"color": "#3355ff",
					"name": "Color 3",
					"slug": "theme-3"
				},
				{
					"color": "#0a0a0a33",
					"name": "Color 4",
					"slug": "theme-4"
				},
				{
					"color": "#0a0a0a08",
					"name": "Color 5",
					"slug": "theme-5"
				},
				{
					"color": "#000000",
					"name": "Color 6",
					"slug": "theme-6"
				}
			]
		},
		"layout": {
			"contentSize": "640px",
			"wideSize": "1280px"
		},
		"shadow": {
			"presets": [
				{
					"name": "Soft",
					"shadow": "0 2px 8px rgba(0, 0, 0, 0.08)",
					"slug": "soft"
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"name": "2X-Small",
					"size": "8px",
					"slug": "20"
				},
				{
					"name": "X-Small",
					"size": "16px",
					"slug": "30"
				},
				{
					"name": "Small",
					"size": "clamp(24px, 2.33vw, 32px)",
					"slug": "40"
				},
				{
					"name": "Regular",
					"size": "clamp(32px, 3.49vw, 48px)",
					"slug": "50"
				},
				{
					"name": "Large",
					"size": "clamp(48px, 4.65vw, 64px)",
					"slug": "60"
				},
				{
					"name": "X-Large",
					"size": "clamp(64px, 6.98vw, 96px)",
					"slug": "70"
				},
				{
					"name": "2X-Large",
					"size": "clamp(96px, 9.31vw, 128px)",
					"slug": "80"
				}
			],
			"units": [
				"%",
				"px",
				"em",
				"rem",
				"vh",
				"dvh",
				"vw"
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"fontFace": [
						{
							"fontFamily": "Manrope",
							"fontStretch": "normal",
							"fontStyle": "normal",
							"fontWeight": "200 800",
							"src": [
								"file:./assets/fonts/manrope/manrope-var-normal.woff2"
							]
						}
					],
					"fontFamily": "\"Manrope\", sans-serif",
					"name": "Manrope",
					"slug": "manrope"
				},
				{
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontStretch": "normal",
							"fontStyle": "normal",
							"fontWeight": "100 800",
							"src": [
								"file:./assets/fonts/inter/inter-var-normal.woff2"
							]
						},
						{
							"fontFamily": "Inter",
							"fontStretch": "normal",
							"fontStyle": "italic",
							"fontWeight": "100 800",
							"src": [
								"file:./assets/fonts/inter/inter-var-italic.woff2"
							]
						}
					],
					"fontFamily": "\"Inter\", sans-serif",
					"name": "Inter",
					"slug": "inter"
				},
				{
					"fontFace": [
						{
							"fontFamily": "Archivo",
							"fontStretch": "normal",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"src": [
								"file:./assets/fonts/archivo/archivo-var-normal.woff2"
							]
						},
						{
							"fontFamily": "Archivo",
							"fontStretch": "normal",
							"fontStyle": "italic",
							"fontWeight": "100 900",
							"src": [
								"file:./assets/fonts/archivo/archivo-var-italic.woff2"
							]
						}
					],
					"fontFamily": "\"Archivo\", sans-serif",
					"name": "Archivo",
					"slug": "archivo"
				},
				{
					"fontFace": [
						{
							"fontFamily": "Besley",
							"fontStyle": "normal",
							"fontWeight": "400 900",
							"src": [
								"file:./assets/fonts/besley/besley-var-normal.woff2"
							]
						},
						{
							"fontFamily": "Besley",
							"fontStyle": "italic",
							"fontWeight": "400 900",
							"src": [
								"file:./assets/fonts/besley/besley-var-italic.woff2"
							]
						}
					],
					"fontFamily": "\"Besley\", serif",
					"name": "Besley",
					"slug": "besley"
				},
				{
					"fontFace": [
						{
							"fontFamily": "STIX Two Text",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"src": [
								"file:./assets/fonts/stix-two-text/stix-two-text-var-normal.woff2"
							]
						},
						{
							"fontFamily": "STIX Two Text",
							"fontStyle": "italic",
							"fontWeight": "400 700",
							"src": [
								"file:./assets/fonts/stix-two-text/stix-two-text-var-italic.woff2"
							]
						}
					],
					"fontFamily": "\"STIX Two Text\", serif",
					"name": "STIX Two Text",
					"slug": "stix-two-text"
				},
				{
					"fontFace": [
						{
							"fontFamily": "JetBrains Mono",
							"fontStretch": "normal",
							"fontStyle": "normal",
							"fontWeight": "100 800",
							"src": [
								"file:./assets/fonts/jetbrains-mono/jetbrains-mono-var-normal.woff2"
							]
						},
						{
							"fontFamily": "JetBrains Mono",
							"fontStretch": "normal",
							"fontStyle": "italic",
							"fontWeight": "100 800",
							"src": [
								"file:./assets/fonts/jetbrains-mono/jetbrains-mono-var-italic.woff2"
							]
						}
					],
					"fontFamily": "\"JetBrains Mono\", monospace",
					"name": "JetBrains Mono",
					"slug": "jetbrains-mono"
				},
				{
					"fontFace": [
						{
							"fontFamily": "Archivo Condensed",
							"fontStretch": "normal",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"src": [
								"file:./assets/fonts/archivo-condensed/archivo-condensed-var-normal.woff2"
							]
						},
						{
							"fontFamily": "Archivo Condensed",
							"fontStretch": "normal",
							"fontStyle": "italic",
							"fontWeight": "100 900",
							"src": [
								"file:./assets/fonts/archivo-condensed/archivo-condensed-var-italic.woff2"
							]
						}
					],
					"fontFamily": "\"Archivo Condensed\", sans-serif",
					"name": "Archivo Condensed",
					"slug": "archivo-condensed"
				}
			],
			"fontSizes": [
				{
					"fluid": false,
					"name": "Small",
					"size": "0.875rem",
					"slug": "small"
				},
				{
					"fluid": false,
					"name": "Medium",
					"size": "1.125rem",
					"slug": "medium"
				},
				{
					"fluid": false,
					"name": "Large",
					"size": "1.4375rem",
					"slug": "large"
				},
				{
					"fluid": {
						"max": "1.75rem",
						"min": "1.5rem"
					},
					"name": "X-Large",
					"size": "1.75rem",
					"slug": "x-large"
				},
				{
					"fluid": {
						"max": "2.1875rem",
						"min": "1.625rem"
					},
					"name": "2X-Large",
					"size": "2.1875rem",
					"slug": "2-x-large"
				}
			],
			"writingMode": true
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"blocks": {
			"core/accordion": {
				"spacing": {
					"blockGap": "var(--wp--preset--spacing--50)"
				}
			},
			"core/accordion-heading": {
				"border": {
					"top": {
						"style": "dotted",
						"width": "1px"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--manrope)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontStyle": "normal",
					"fontWeight": "700",
					"letterSpacing": "0rem"
				}
			},
			"core/accordion-item": {
				"spacing": {
					"blockGap": "var(--wp--preset--spacing--30)"
				}
			},
			"core/accordion-panel": {
				"spacing": {
					"padding": {
						"bottom": "var(--wp--preset--spacing--50)"
					}
				}
			},
			"core/audio": {
				"css": "& audio{background-color:var(--wp--preset--color--theme-5);border-radius:10px;color:var(--wp--preset--color--theme-2);color-scheme:var(--wp--custom--control-scheme, light);} & audio::-webkit-media-controls-enclosure{background-color:transparent;border-radius:10px;} & audio::-webkit-media-controls-panel{background-color:transparent;} & audio::-webkit-media-controls-current-time-display{text-shadow:none;color:var(--wp--preset--color--theme-2);} & audio::-webkit-media-controls-time-remaining-display{text-shadow:none;color:var(--wp--preset--color--theme-2);}"
			},
			"core/avatar": {
				"border": {
					"radius": {
						"bottomLeft": "10px",
						"bottomRight": "10px",
						"topLeft": "10px",
						"topRight": "10px"
					}
				}
			},
			"core/button": {
				":active": {
					"color": {
						"background": "color-mix(in srgb, var(--wp--preset--color--theme-2) 85%, transparent)",
						"text": "var(--wp--preset--color--theme-1)"
					}
				},
				":focus": {
					"border": {
						"bottom": {
							"style": "dotted",
							"width": "1px"
						},
						"left": {
							"style": "dotted",
							"width": "1px"
						},
						"right": {
							"style": "dotted",
							"width": "1px"
						},
						"top": {
							"style": "dotted",
							"width": "1px"
						}
					},
					"color": {
						"background": "color-mix(in srgb, var(--wp--preset--color--theme-2) 85%, transparent)",
						"text": "var(--wp--preset--color--theme-1)"
					},
					"outline": {
						"offset": "4px"
					}
				},
				":focus-visible": {
					"border": {
						"bottom": {
							"style": "dotted",
							"width": "1px"
						},
						"left": {
							"style": "dotted",
							"width": "1px"
						},
						"right": {
							"style": "dotted",
							"width": "1px"
						},
						"top": {
							"style": "dotted",
							"width": "1px"
						}
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--theme-6)",
						"text": "var(--wp--preset--color--theme-1)"
					}
				},
				"border": {
					"bottom": {
						"color": "var(--wp--preset--color--theme-2)",
						"style": "solid",
						"width": "1px"
					},
					"left": {
						"color": "var(--wp--preset--color--theme-2)",
						"style": "solid",
						"width": "1px"
					},
					"radius": {
						"bottomLeft": "10px",
						"bottomRight": "10px",
						"topLeft": "10px",
						"topRight": "10px"
					},
					"right": {
						"color": "var(--wp--preset--color--theme-2)",
						"style": "solid",
						"width": "1px"
					},
					"top": {
						"color": "var(--wp--preset--color--theme-2)",
						"style": "solid",
						"width": "1px"
					}
				},
				"spacing": {
					"padding": {
						"bottom": "var(--wp--preset--spacing--30)",
						"left": "var(--wp--preset--spacing--40)",
						"right": "var(--wp--preset--spacing--40)",
						"top": "var(--wp--preset--spacing--30)"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--manrope)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "600",
					"letterSpacing": "0rem"
				},
				"variations": {
					"outline": {
						":active": {
							"color": {
								"background": "color-mix(in srgb, var(--wp--preset--color--theme-2) 85%, transparent)",
								"text": "var(--wp--preset--color--theme-1)"
							}
						},
						":focus": {
							"border": {
								"bottom": {
									"style": "dotted",
									"width": "1px"
								},
								"left": {
									"style": "dotted",
									"width": "1px"
								},
								"right": {
									"style": "dotted",
									"width": "1px"
								},
								"top": {
									"style": "dotted",
									"width": "1px"
								}
							},
							"color": {
								"background": "color-mix(in srgb, var(--wp--preset--color--theme-2) 85%, transparent)",
								"text": "var(--wp--preset--color--theme-1)"
							},
							"outline": {
								"offset": "4px"
							}
						},
						":focus-visible": {
							"border": {
								"bottom": {
									"style": "dotted",
									"width": "1px"
								},
								"left": {
									"style": "dotted",
									"width": "1px"
								},
								"right": {
									"style": "dotted",
									"width": "1px"
								},
								"top": {
									"style": "dotted",
									"width": "1px"
								}
							}
						},
						":hover": {
							"color": {
								"background": "var(--wp--preset--color--theme-5)",
								"text": "var(--wp--preset--color--theme-6)"
							}
						},
						"border": {
							"bottom": {
								"color": "var(--wp--preset--color--theme-2)",
								"style": "solid",
								"width": "1px"
							},
							"left": {
								"color": "var(--wp--preset--color--theme-2)",
								"style": "solid",
								"width": "1px"
							},
							"right": {
								"color": "var(--wp--preset--color--theme-2)",
								"style": "solid",
								"width": "1px"
							},
							"top": {
								"color": "var(--wp--preset--color--theme-2)",
								"style": "solid",
								"width": "1px"
							}
						},
						"spacing": {
							"padding": {
								"bottom": "var(--wp--preset--spacing--30)",
								"left": "var(--wp--preset--spacing--40)",
								"right": "var(--wp--preset--spacing--40)",
								"top": "var(--wp--preset--spacing--30)"
							}
						},
						"typography": {
							"letterSpacing": "0rem"
						}
					}
				}
			},
			"core/buttons": {
				"spacing": {
					"blockGap": "var(--wp--preset--spacing--30)"
				}
			},
			"core/calendar": {
				"css": "& :where(table:not(.has-text-color)) td{border-color: var(--wp--preset--color--theme-4) !important;} & :where(table:not(.has-text-color)) th{border-color: var(--wp--preset--color--theme-4) !important;} & :where(table:not(.has-text-color)){color:var(--wp--preset--color--theme-2)} & :where(.wp-block-calendar table:not(.has-background) th){background-color:var(--wp--preset--color--theme-5)}"
			},
			"core/categories": {
				"css": "& {padding-inline-start: var(--wp--preset--spacing--30);} & ul {padding-inline-start: var(--wp--preset--spacing--30);}"
			},
			"core/code": {
				"border": {
					"color": "var(--wp--preset--color--theme-4)",
					"radius": "5px",
					"style": "solid",
					"width": "1px"
				},
				"spacing": {
					"padding": {
						"bottom": "var(--wp--preset--spacing--30)",
						"left": "var(--wp--preset--spacing--30)",
						"right": "var(--wp--preset--spacing--30)",
						"top": "var(--wp--preset--spacing--30)"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--jetbrains-mono)"
				}
			},
			"core/comment-author-name": {
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						}
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--manrope)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontStyle": "normal",
					"fontWeight": "600",
					"letterSpacing": "0rem"
				}
			},
			"core/comment-content": {
				"border": {
					"radius": {
						"bottomLeft": "10px",
						"bottomRight": "10px",
						"topLeft": "10px",
						"topRight": "10px"
					}
				},
				"color": {
					"background": "var(--wp--preset--color--theme-5)"
				},
				"css": "& p{margin-top:var(--wp--preset--spacing--40); margin-bottom:0;} & > :first-child{margin-top:0;}",
				"spacing": {
					"padding": {
						"bottom": "var(--wp--preset--spacing--30)",
						"left": "var(--wp--preset--spacing--30)",
						"right": "var(--wp--preset--spacing--30)",
						"top": "var(--wp--preset--spacing--30)"
					}
				}
			},
			"core/comment-date": {
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						}
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--manrope)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontStyle": "normal",
					"fontWeight": "400",
					"letterSpacing": "0rem"
				}
			},
			"core/comment-edit-link": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--manrope)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontStyle": "normal",
					"fontWeight": "400",
					"textTransform": "none",
					"letterSpacing": "0rem"
				}
			},
			"core/comment-reply-link": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--manrope)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontStyle": "normal",
					"fontWeight": "400",
					"textTransform": "none",
					"letterSpacing": "0rem"
				}
			},
			"core/comments": {
				"spacing": {
					"margin": {
						"bottom": "var(--wp--preset--spacing--60)",
						"top": "var(--wp--preset--spacing--60)"
					}
				}
			},
			"core/comments-pagination": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--manrope)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "600"
				}
			},
			"core/comments-title": {
				"spacing": {
					"margin": {
						"bottom": "var(--wp--preset--spacing--50)"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--manrope)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "400",
					"fontStyle": "normal",
					"letterSpacing": "0rem"
				}
			},
			"core/details": {
				"border": {
					"top": {
						"style": "dotted",
						"width": "1px"
