			"palette": [
				{
					"color": "#ecf7fe",
					"name": "Color 1",
					"slug": "theme-1"
				},
				{
					"color": "#0d1b26bf",
					"name": "Color 2",
					"slug": "theme-2"
				},
				{
					"color": "#006699",
					"name": "Color 3",
					"slug": "theme-3"
				},
				{
					"color": "#0d1b2633",
					"name": "Color 4",
					"slug": "theme-4"
				},
				{
					"color": "#0d1b2608",
					"name": "Color 5",
					"slug": "theme-5"
				},
				{
					"color": "#0d1b26",
					"name": "Color 6",
					"slug": "theme-6"
				}
			]
		},
