{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Golden Hour",
	"settings": {
		"color": {
			"duotone": [
				{
					"colors": [
						"#7a1000",
						"#ffd9bd"
					],
					"name": "Peach on maroon",
					"slug": "duotone-1"
				}
			],
			"palette": [
				{
					"color": "#7a1000",
					"name": "Base",
					"slug": "base"
				},
				{
					"color": "#ffd9bd",
					"name": "Contrast",
					"slug": "contrast"
				},
				{
					"color": "#ff8c52",
					"name": "Accent",
					"slug": "accent-1"
				},
				{
					"color": "#fff1e8",
					"name": "Strong Contrast",
					"slug": "accent-3"
				},
				{
					"color": "#ffd9bd1a",
					"name": "Surface",
					"slug": "accent-5"
				},
				{
					"color": "#ffd9bd40",
					"name": "Border",
					"slug": "accent-6"
				}
			]
		},
		"custom": {
			"controlScheme": "dark"
		}
	},
	"styles": {
		"blocks": {
			"core/post-featured-image": {
				"filter": {
					"duotone": "var:preset|duotone|duotone-1"
				}
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--manrope)",
					"fontStyle": "normal",
					"fontWeight": "500"
				}
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--manrope)",
			"fontStyle": "normal",
			"fontWeight": "400"
		}
	}
}
