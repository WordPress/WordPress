{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Quote Mark",
	"slug": "text-quote-mark",
	"blockTypes": ["core/heading", "core/paragraph"],
	"styles": {
		"css": "&::before{content:\"❝\" / \"\";display:block;color:var(--wp--preset--color--theme-4);font-size:var(--wp--preset--font-size--2-x-large);line-height:1;}"
	}
}
